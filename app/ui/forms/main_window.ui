            <size>
             <width>10</width>
             <height>10</height>
            </size>
           </property>
          </spacer>
         </item>
        </layout>
       </widget>
      </widget>
      <widget class="ActivityPanel" name="activityPanel">
       <layout class="QVBoxLayout" name="activityLayout">
        <property name="spacing">
         <number>6</number>
        </property>
        <property name="leftMargin">
         <number>24</number>
        </property>
        <property name="topMargin">
         <number>8</number>
        </property>
        <property name="rightMargin">
         <number>24</number>
        </property>
        <property name="bottomMargin">
         <number>8</number>
        </property>
        <item>
         <layout class="QHBoxLayout" name="activityHeader">
          <property name="spacing">
           <number>12</number>
          </property>
          <item>
           <widget class="QLabel" name="activityTitle">
            <property name="text">
             <string>ACTIVITY</string>
            </property>
            <property name="role" stdset="0">
             <string>sectionTitle</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QFrame" name="activityStatusDot">
            <property name="minimumSize">
             <size>
              <width>7</width>
              <height>7</height>
             </size>
            </property>
            <property name="maximumSize">
             <size>
              <width>7</width>
              <height>7</height>
             </size>
            </property>
            <property name="role" stdset="0">
             <string>statusDot</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QLabel" name="activityStatusLabel">
            <property name="text">
             <string>Ready</string>
            </property>
            <property name="role" stdset="0">
             <string>muted</string>
            </property>
           </widget>
          </item>
          <item>
           <spacer name="activityHeaderSpacer">
            <property name="orientation">
             <enum>Qt::Horizontal</enum>
            </property>
            <property name="sizeHint" stdset="0">
             <size>
              <width>40</width>
              <height>10</height>
             </size>
            </property>
           </spacer>
          </item>
          <item>
           <widget class="QPushButton" name="activityOpenLogButton">
            <property name="toolTip">
             <string>Open the full log file</string>
            </property>
            <property name="text">
             <string>Open log file</string>
            </property>
            <property name="role" stdset="0">
             <string>link</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QPushButton" name="activityClearButton">
            <property name="toolTip">
             <string>Clear the list (the log file is kept)</string>
            </property>
            <property name="text">
             <string>Clear</string>
            </property>
            <property name="role" stdset="0">
             <string>link</string>
            </property>
           </widget>
          </item>
          <item>
           <widget class="QToolButton" name="activityToggleButton">
            <property name="autoRaise">
             <bool>true</bool>
            </property>
           </widget>
          </item>
         </layout>
        </item>
        <item>
         <widget class="QPlainTextEdit" name="activityLog">
          <property name="frameShape">
           <enum>QFrame::NoFrame</enum>
          </property>
          <property name="readOnly">
           <bool>true</bool>
          </property>
          <property name="placeholderText">
           <string>Runs and log messages appear here.</string>
          </property>
         </widget>
        </item>
       </layout>
      </widget>
     </widget>
    </item>
   </layout>
  </widget>
